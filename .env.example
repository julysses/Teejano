# Teejano Agency — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# === SHOPIFY ===
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# === KLAVIYO ===
KLAVIYO_PRIVATE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KLAVIYO_LIST_ID_ALL=XXXXXX
KLAVIYO_LIST_ID_ENGAGED=XXXXXX

# === CANVA (optional — local_composite adapter used if absent) ===
CANVA_API_KEY=

# === PRINT ON DEMAND (optional — adapter stubs only in V2) ===
PRINTIFY_API_TOKEN=
PRINTFUL_API_KEY=

# === SMS (optional) ===
POSTSCRIPT_API_KEY=
ATTENTIVE_API_KEY=
